# Copy to .env. Every setting is an environment variable (12-factor); see src/config.ts for defaults.

# docker-compose
DOMAIN=api.example.com
POSTGRES_PASSWORD=change-me
# TWENTY_IMAGE=registry.cn-hongkong.aliyuncs.com/<namespace>/twenty-backend:<tag>
# POSTGRES_IMAGE=registry.cn-hongkong.aliyuncs.com/<namespace>/postgres:17-alpine
# CADDY_IMAGE=registry.cn-hongkong.aliyuncs.com/<namespace>/caddy:2-alpine

# Local development only (compose sets DATABASE_URL itself)
DATABASE_URL=postgres://twenty:twenty@localhost:5432/twenty

LOG_LEVEL=info
JWT_SECRET=replace-with-at-least-32-random-characters
# Audiences accepted in Apple ID tokens: iOS bundle ID (later also the web Services ID), comma-separated.
APPLE_CLIENT_IDS=com.example.twenty

# AI: qwen (Alibaba Cloud Model Studio) or fake (deterministic, no network)
AI_PROVIDER=qwen
QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus
AI_DAILY_BREAKDOWN_LIMIT=5

# Nightly pg_dump to OSS (the db.backup job is only scheduled when OSS_BUCKET is set)
# OSS_REGION=oss-cn-hongkong
# OSS_BUCKET=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# BACKUP_CRON=30 19 * * *
